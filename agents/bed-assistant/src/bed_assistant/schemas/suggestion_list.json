{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "suggestions": {
      "maxItems": 6,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "plantId": {
            "type": "string",
            "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$",
            "description": "ID der Sorte aus find_plants."
          },
          "kind": {
            "type": "string",
            "enum": [
              "SINGLE",
              "ROW"
            ],
            "description": "SINGLE: Einzelpflanze, ROW: Reihe."
          },
          "x": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "multipleOf": 5,
            "description": "Position in cm vom linken Beetrand, Vielfaches von 5."
          },
          "y": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991,
            "multipleOf": 5,
            "description": "Position in cm vom oberen Beetrand, Vielfaches von 5."
          },
          "lengthCm": {
            "description": "Nur für Reihen: Länge in cm.",
            "type": "integer",
            "minimum": 5,
            "maximum": 9007199254740991,
            "multipleOf": 5
          },
          "orientation": {
            "description": "Nur für Reihen: H waagerecht, V senkrecht.",
            "type": "string",
            "enum": [
              "H",
              "V"
            ]
          },
          "startDate": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
            "description": "Montag der Pflanzwoche (JJJJ-MM-TT)."
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300,
            "description": "Kurze Begründung auf Deutsch."
          }
        },
        "required": [
          "plantId",
          "kind",
          "x",
          "y",
          "startDate",
          "reason"
        ]
      }
    },
    "summary": {
      "type": "string",
      "maxLength": 800,
      "description": "Kurze Zusammenfassung der Vorschläge auf Deutsch."
    }
  },
  "required": [
    "suggestions",
    "summary"
  ]
}
